# Copy to .env and fill in. Everything is optional: with no token the app runs in DEMO MODE.
TELEGRAM_BOT_TOKEN=
# Optional Gemini card routing. Core app and manual first aid work without this key.
GEMINI_API_KEY=
# Vision-capable model for medicine photo reading and card routing (default gemini-1.5-flash).
GEMINI_MODEL=gemini-1.5-flash
# Separate vision model override for medicine strip OCR (defaults to GEMINI_MODEL).
GEMINI_VISION_MODEL=
# Optional override. Render's assigned HTTPS URL and local localhost URLs are inferred.
PUBLIC_BASE_URL=
# Overpass and Nominatim ask apps to identify themselves. Use a real email.
CONTACT_EMAIL=you@example.com
# Exact IPs of trusted reverse proxies, if any. Never use *.
FORWARDED_ALLOW_IPS=127.0.0.1
